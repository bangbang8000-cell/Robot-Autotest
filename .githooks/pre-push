#!/bin/sh
# pre-push：阻断直推 main。
#
# 现状：仓库已转公开，GitHub 服务端 ruleset（protect-main）已生效，
# 本钩子是第二道防线，用于在本地就直接拦住，避免往返一次远程拒绝。
#
# 例外：
#   - 镜像远程（origin，群晖）不拦，它的 main 必须跟随 GitHub。
#   - ALLOW_MAIN_PUSH=1 放行一次，仅限管理员初始化与紧急回滚。
#
# 安装：git config core.hooksPath .githooks

remote_name="$1"
remote_url="$2"
protected="refs/heads/main"

# 镜像仓放行：群晖只做内网镜像，不承载协作流程
case "$remote_url" in
    *10.202.54.201*) exit 0 ;;
esac
[ "$remote_name" = "origin" ] && exit 0

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$remote_ref" = "$protected" ] || continue

    if [ "${ALLOW_MAIN_PUSH:-0}" = "1" ]; then
        echo "[pre-push] ALLOW_MAIN_PUSH=1，放行一次直推 main" >&2
        continue
    fi

    cat >&2 <<'EOF'

============================================================
 禁止直接推送到 main。

 请改用分支 + PR：
   git switch -c feat/<模块>-<简述>
   git push github HEAD
   然后在 GitHub 上开 Pull Request。

 确需直推（仅限初始化、紧急回滚）：
   ALLOW_MAIN_PUSH=1 git push github main

 规则见 CONTRIBUTING.md
============================================================

EOF
    status=1
done

exit $status
