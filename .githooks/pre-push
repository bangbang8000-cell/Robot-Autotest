#!/bin/sh
# pre-push：直推 main 默认放行（仅提示）。
#
# 现状：GitHub 服务端 ruleset（protect-main）对本账号配置了 bypass，
# 本地钩子不再阻断，只在直推 main 时打印提醒，避免误操作到非预期分支。
#
# 例外：
#   - 镜像远程（origin，群晖）不拦，它的 main 必须跟随 GitHub。
#   - 设置 ALLOW_MAIN_PUSH=1 可关闭提示。
#
# 安装：git config core.hooksPath .githooks

remote_name="$1"
remote_url="$2"
protected="refs/heads/main"

# 镜像仓放行：群晖只做内网镜像，不承载协作流程
case "$remote_url" in
    *10.202.54.201*) exit 0 ;;
esac
[ "$remote_name" = "origin" ] && exit 0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$remote_ref" = "$protected" ] || continue

    if [ "${ALLOW_MAIN_PUSH:-0}" = "1" ]; then
        continue
    fi

    cat >&2 <<'EOF'

------------------------------------------------------------
 提醒：正在直接推送 main（评审门禁已被 bypass）。

 正常协作仍建议分支 + PR：
   git switch -c feat/<模块>-<简述>
   git push github HEAD

 规则见 CONTRIBUTING.md
------------------------------------------------------------

EOF
done

exit 0
