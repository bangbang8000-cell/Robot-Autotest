{
  "name": "@robot-autotest/editor",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Robot Framework 三视图编辑器（衍生自 viadee/roboscope v0.16.1，Apache-2.0）",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/editor.umd.cjs",
  "module": "./dist/editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/editor.js"
    }
  },
  "scripts": {
    "build": "vue-tsc --noEmit -p tsconfig.build.json && vite build",
    "test": "vitest run",
    "type-check": "vue-tsc --noEmit -p tsconfig.build.json",
    "lint": "vue-tsc --noEmit -p tsconfig.build.json"
  },
  "peerDependencies": {
    "pinia": "^2.2.0 || ^3.0.0",
    "vue": "^3.5.0",
    "vue-i18n": "^10.0.0 || ^11.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.42.0",
    "@vue-flow/minimap": "^1.5.0",
    "dompurify": "^3.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^26.1.0",
    "pinia": "^2.3.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vitest": "^3.2.7",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.5",
    "vue-tsc": "^2.1.10"
  }
}
